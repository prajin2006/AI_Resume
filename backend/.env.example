# NextHire AI Backend Environment Configuration
PROJECT_NAME="NextHire — AI Resume Analyzer"
SECRET_KEY="generate-a-secure-random-jwt-secret-for-production"

# Database Configuration (PostgreSQL on Render/Production, or SQLite for local dev)
DATABASE_URL="sqlite:///./nexthire.db"
# Example PostgreSQL on Render:
# DATABASE_URL="postgresql://username:password@hostname:5432/databasename"

# AI Provider Keys (Optional - Heuristic fallbacks are included if keys are not provided)
AI_PROVIDER="gemini" # gemini, openai, anthropic, or heuristic
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""

# Production Frontend URL (e.g. your Vercel deployment URL)
FRONTEND_URL="https://your-nexthire-app.vercel.app"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
